# ─────────────────────────────────────────────────────────────────────────
# RECOMMENDED: route through the fortune-llm gateway. See
# ../../fortune-llm/README.md for one-time deploy. Then set both:
#
#   ANTHROPIC_BASE_URL=https://fortune-llm.fortunee.workers.dev
#   ANTHROPIC_API_KEY=<gateway-token>        # NOT an Anthropic key
#
# OR: bring your own Anthropic key (https://console.anthropic.com/).
# ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_BASE_URL=https://fortune-llm.fortunee.workers.dev

# Required for AI processing, theme detection, and essay drafting.
ANTHROPIC_API_KEY=                          # gateway token (NOT an Anthropic key)

# Optional. If unset, cross-link similarity falls back to a deterministic
# lexical scorer (worse quality but works offline and in tests).
VOYAGE_API_KEY=

# SQLite database file path (relative to project root).
DATABASE_PATH=./knowledge.db
