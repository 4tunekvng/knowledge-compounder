{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "knowledge-compounder",
	// Own domain; the workers.dev address stays on too.
	"routes": [
		{ "pattern": "knowledge-compounder.fortuneking.dev", "custom_domain": true }
	],
	"workers_dev": true,
	// worker.ts wraps the OpenNext build (.open-next/worker.js) and adds the
	// cron handler that drains pending sources.
	"main": "worker.ts",
	"compatibility_date": "2025-04-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	// Every 5 minutes: process sources stored but not yet processed (see
	// worker.ts and app/api/drain/route.ts).
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			// Knowledge-compounder data lives in this D1 database. Bound as
			// `env.DB` inside the worker (lib/db/client.ts reads env.DB).
			// `remote: true` means even local dev hits the live D1 so data is
			// consistent between wrangler dev and the deployed worker.
			"binding": "DB",
			"database_name": "knowledge-compounder",
			"database_id": "4409f5de-575c-4a1b-a41d-10ff985bd62d",
			"migrations_dir": "migrations",
			"remote": true
		}
	],
	// Google sign-in (fortuneking-auth). worker.ts asks it who each visitor
	// is through this binding; see lib/auth/gate.ts.
	"services": [{ "binding": "AUTH", "service": "fortuneking-auth" }],
	"vars": {
		"ANTHROPIC_MODEL": "claude-sonnet-5-5"
	}
}
