{
  "name": "knowledge-compounder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:reset": "rm -f knowledge.db knowledge.test.db",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare upload",
    "cf:secret:base-url": "wrangler secret put ANTHROPIC_BASE_URL",
    "cf:secret:key": "wrangler secret put ANTHROPIC_API_KEY",
    "cf:tail": "wrangler tail"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "jsdom": "^29.1.0",
    "linkedom": "^0.18.12",
    "next": "^16.3.5",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unpdf": "^1.6.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "glob": ">=10.5.0",
    "form-data": ">=4.0.6",
    "brace-expansion": ">=1.1.21",
    "browserslist": ">=4.29.5",
    "js-yaml": ">=4.3.2",
    "source-map-js": ">=1.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.120.0"
  }
}
